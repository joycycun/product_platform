# Copy to .env (never commit credentials). Default binds to localhost.
BOOTSTRAP_USER=admin
BOOTSTRAP_PASSWORD=change-this-before-use
# Sales integration remains unavailable unless configured.
SALES_TOKEN=
SALES_SOURCE_SYSTEM=company-sales
# Real web search provider: Tavily
TAVILY_API_KEY=
# OpenAI-compatible chat completions service, including approved local inference servers
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=
# Explicit company approval is required for sending project text to the configured model.
ALLOW_MODEL_PROJECT_DATA=false
COOKIE_SECURE=false
